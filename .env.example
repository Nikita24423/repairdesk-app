# PostgreSQL (Neon). Use the pooled URL for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional: direct (non-pooler) URL for drizzle-kit push/migrate
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Регистрация по коду приглашения. Пока не задан — страница /register отключена.
REGISTRATION_CODE=
